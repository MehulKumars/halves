{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/hooks/gd_check.ps1"],
            "timeout": 90,
            "statusMessage": "Godot script check"
          }
        ]
      }
    ]
  }
}

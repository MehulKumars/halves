# Godot 4+ specific ignores
.godot/
.import/
export.cfg
# export_presets.cfg IS committed: Godot 4 keeps keystore passwords in .godot/export_credentials.cfg.
# Still check `git diff export_presets.cfg` before committing.

# Imported translations (automatically generated from CSV files)
*.translation.godot/
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build outputs and the Android build template (reinstalled with --install-android-build-template)
build/
exports/
Exports/
android/
*.apk
*.aab
*.idsig

# Signing keys: never commit. Keep them in 1Password.
*.keystore
*.jks

# Version-exact API dump for Claude (godot --doctool docs/api)
docs/api/

# IDE, OS and local tool settings
.vscode/
.idea/
.DS_Store
.claude/settings.local.json

# Plugin specific
addons/script-ide/
addons/ef_ds_uids/

# Downloaded print sources (tools/art/fetch_prints.ps1)
tools/art/src/
